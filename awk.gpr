with "config/awk_config.gpr";

project Awk is
   for Source_Dirs use ("src/library", "src/main", "config");
   for Object_Dir use "obj/" & Awk_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Main use ("awk.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Artifacts ("share/awk") use ("resources/messages");
   end Install;
end Awk;
