with "../awk.gpr";
with "aunit.gpr";
with "project_tools.gpr";

project Awk_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("awk_tests_main.adb", "awk_workflows.adb");
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatw.X", "-g");
   end Compiler;
end Awk_Tests;
